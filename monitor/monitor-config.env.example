# Install as ~/.config/filament_iq/monitor-config.conf (monitor.py's CONFIG_FILE).
# SPOOLMAN_URL must be set: the code default is only a placeholder.
HA_URL=http://YOUR_HA_IP:8123
SPOOLMAN_URL=http://YOUR_HA_IP:7912
ARTIFACT_ROOT=/mnt/store/filament_iq/monitor
PRINTER_SERIAL=YOUR_PRINTER_SERIAL
AMS_SLOTS=1,2,3,4,5,6
HA_POLL_INTERVAL=30
PRINT_POLL_INTERVAL=10
OUTAGE_POLL_INTERVAL=10
LOG_RETENTION_DAYS=7
APPDAEMON_ADDON_ID=a0d7b954_appdaemon

# Resource monitoring thresholds
# RESOURCE_POLL_INTERVAL=60
# RESOURCE_CPU_WARN=80
# RESOURCE_MEM_WARN=85
# RESOURCE_DISK_WARN=85
# RESOURCE_SWAP_WARN=90
# RESOURCE_TEMP_WARN_F=158

# Notifications: resource alerts go through HA's script.notify_jerry
# (tag/persist per metric, cleared once the metric recovers).
# NOTIFY_SERVICE is no longer read.
